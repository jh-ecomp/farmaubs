# FARMAUBS — apps/frontend/.env.example
# Modelo de variáveis de ambiente do Frontend (Vite / React — ADR-011)
# Copie para apps/frontend/.env e ajuste conforme necessário.

# URL base da API consumida pelo frontend
# (/api/v1 utiliza o proxy configurado no vite.config.ts para evitar problemas de CORS no navegador)
VITE_API_URL=/api/v1

# Alvo da API backend direcionado pelo proxy reverso do Vite em ambiente de desenvolvimento
VITE_PROXY_TARGET=http://localhost:3000
