# ============================================================
# FARMAUBS — .env.example
# Modelo versionado de variáveis de ambiente (ADR-027)
# Copie para .env e preencha os valores reais.
# O arquivo .env NUNCA deve ser commitado (.gitignore).
# ============================================================

# ------------------------------------------------------------
# SEÇÃO 1 — BANCO DE DADOS (PostgreSQL — ADR-015)
# ------------------------------------------------------------

# Banco/usuário/senha usados pelo serviço postgres do compose
POSTGRES_DB=farmaubs
POSTGRES_USER=farmaubs_admin
POSTGRES_PASSWORD=<DEFINIR_SENHA_FORTE>

# DB_HOST/DB_PORT no .env valem para o contexto HOST (tools, CLI nativa).
# Dentro do compose, o serviço api sobrescreve para postgres:5432 via environment.
DB_HOST=localhost
DB_PORT=5434
DB_SCHEMA=public

# Role de aplicação (AC-02, ADR-016) — DML, não-dona das tabelas.
# Criada pelo init script infra/db/init/01-create-role-farmaubs-app.sh
FARMAUBS_APP_DB_PASSWORD=<DEFINIR_SENHA_FORTE>

# Credenciais de runtime da API — role de aplicação (nunca superuser)
DB_USER=farmaubs_app
DB_PASSWORD=<mesmo valor de FARMAUBS_APP_DB_PASSWORD>

# Credenciais de migração — owner das tabelas (DDL)
MIGRATION_DB_USER=farmaubs_admin
MIGRATION_DB_PASSWORD=<mesmo valor de POSTGRES_PASSWORD>

# ------------------------------------------------------------
# SEÇÃO 2 — API BACKEND (NestJS — ADR-005)
# ------------------------------------------------------------

API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# ------------------------------------------------------------
# SEÇÃO 3 — AUTENTICAÇÃO E SESSÃO (ADR-006)
# ------------------------------------------------------------

# Segredo de assinatura de sessão, ÚNICO por ambiente (ADR-027)
SESSION_SECRET=<GERAR_VALOR_ALEATORIO_UNICO_POR_AMBIENTE>
SESSION_TTL_MINUTES=60          # NF012 — timeout de inatividade
SESSION_WARNING_MINUTES=5       # NF012 — aviso antes do encerramento
LOGIN_MAX_ATTEMPTS=5            # RF002 — bloqueio após tentativas inválidas
LOGIN_BLOCK_MINUTES=15          # RF002 — duração do bloqueio
PASSWORD_RESET_TTL_HOURS=2      # RF003 — validade do link de redefinição
BCRYPT_COST=12                  # NF011 — fator de custo mínimo

# ------------------------------------------------------------
# SEÇÃO 4 — E-MAIL TRANSACIONAL (RF001, RF003, RF022)
# ------------------------------------------------------------

SMTP_HOST=smtp.provedor.com.br
SMTP_PORT=587
SMTP_USER=no-reply@farmaubs.com.br
SMTP_PASS=<DEFINIR_SENHA_SMTP>
SMTP_FROM=no-reply@farmaubs.com.br
SMTP_SECURE=true

# ------------------------------------------------------------
# SEÇÃO 5 — SEGURANÇA DE DADOS (NF010 — LGPD)
# ------------------------------------------------------------

# Chave AES-256 (32 bytes) para criptografia em repouso de CNS/CPF
ENCRYPTION_KEY=<GERAR_CHAVE_32_BYTES>

# ------------------------------------------------------------
# SEÇÃO 6 — ALERTAS E PARÂMETROS OPERACIONAIS (RF022/RF023/RF027)
# ------------------------------------------------------------

ALERT_EXPIRY_DAYS=90            # RF022 — limiar de alerta de vencimento
ALERT_SHORT_VALIDITY_MONTHS=6   # RF024 — validade curta exige confirmação
SAFETY_STOCK_DAYS=30            # RF027 — estoque de segurança (dias)
CAF_LEAD_TIME_DAYS=15           # RF015 — tempo médio de entrega da CAF

# ------------------------------------------------------------
# SEÇÃO 7 — RELATÓRIOS (ADR-009)
# ------------------------------------------------------------

REPORTS_DIR=./storage/reports
REPORTS_RETENTION_HOURS=48      # expurgo de arquivos gerados

# ------------------------------------------------------------
# SEÇÃO 8 — OBSERVABILIDADE (ADR-026 — futuro)
# ------------------------------------------------------------

LOG_LEVEL=info