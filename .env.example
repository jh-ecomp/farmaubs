# ============================================================
# FARMAUBS — .env.example
# Modelo versionado de variáveis de ambiente (ADR-027)
# Copie para .env e preencha os valores reais.
# O arquivo .env NUNCA deve ser commitado (.gitignore).
# ============================================================

# ------------------------------------------------------------
# SEÇÃO 1 — BANCO DE DADOS (PostgreSQL — ADR-015)
# ------------------------------------------------------------

# Banco/usuário/senha usados pelo serviço postgres do compose
POSTGRES_DB=farmaubs
POSTGRES_USER=farmaubs_admin
POSTGRES_PASSWORD=<DEFINIR_SENHA_FORTE>

# DB_HOST/DB_PORT no .env valem para o contexto HOST (tools, CLI nativa).
# Dentro do compose, o serviço api sobrescreve para postgres:5432 via environment.
DB_HOST=localhost
DB_PORT=5434
DB_SCHEMA=public

# Role de aplicação (AC-02, ADR-016) — DML, não-dona das tabelas.
# Criada pelo init script infra/db/init/01-create-role-farmaubs-app.sh
FARMAUBS_APP_DB_PASSWORD=<DEFINIR_SENHA_FORTE>

# Credenciais de runtime da API — role de aplicação (nunca superuser)
DB_USER=farmaubs_app
DB_PASSWORD=<mesmo valor de FARMAUBS_APP_DB_PASSWORD>
DB_POOL_MAX=25                  # NF014 / RL-01 — máximo de conexões simultâneas no pool pg

# Credenciais de migração — owner das tabelas (DDL)
MIGRATION_DB_USER=farmaubs_admin
MIGRATION_DB_PASSWORD=<mesmo valor de POSTGRES_PASSWORD>

# --- Testes de integração (banco efêmero: docker-compose.test.yml) ---
TEST_DB_HOST=localhost
TEST_DB_PORT=5435
TEST_DB_DATABASE=farmaubs
TEST_ADMIN_DB_PASSWORD=<mesma que POSTGRES_PASSWORD em docker-compose.test.yml>
TEST_APP_DB_PASSWORD=<mesma que FARMAUBS_APP_DB_PASSWORD em docker-compose.test.yml>

# ------------------------------------------------------------
# SEÇÃO 2 — API BACKEND (NestJS — ADR-005)
# ------------------------------------------------------------

API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
APP_ENV=development             # development | hml | production (usado nas travas de seed e observabilidade)
TZ=America/Sao_Paulo            # NF003 / RL-02 — fuso horário civil brasileiro
# Origens permitidas no CORS separadas por vírgula (obrigatória em NODE_ENV=production — RL-01)
CORS_ORIGIN=http://localhost:5173
# Controla exposição de /api/v1/docs (em production fica oculto por padrão; defina true apenas se necessário)
SWAGGER_ENABLED=true
# Habilita rate limiting HTTP (@nestjs/throttler — padrão: true fora de NODE_ENV=test)
THROTTLER_ENABLED=true

# ------------------------------------------------------------
# SEÇÃO 3 — AUTENTICAÇÃO E SESSÃO (ADR-006)
# ------------------------------------------------------------

# Segredo reservado de ambiente (ADR-027; atualmente o token de sessão usa entropia criptográfica + SHA-256 no banco)
SESSION_SECRET=<GERAR_VALOR_ALEATORIO_UNICO_POR_AMBIENTE>
SESSION_TTL_MINUTES=60          # NF012 — timeout de inatividade
SESSION_WARNING_MINUTES=5       # NF012 — aviso antes do encerramento
LOGIN_MAX_ATTEMPTS=5            # RF002 — bloqueio após tentativas inválidas
LOGIN_BLOCK_MINUTES=15          # RF002 — duração do bloqueio
PASSWORD_RESET_TTL_HOURS=2      # RF003 — validade do link de redefinição
BCRYPT_COST=12                  # NF011 — fator de custo mínimo

# ------------------------------------------------------------
# SEÇÃO 4 — E-MAIL TRANSACIONAL (RF001, RF003, RF022 — RL-03)
# ------------------------------------------------------------

# Provedor de e-mail: "console" (padrão seguro sem custo externo) ou "resend" (API HTTPS com timeout 8s)
EMAIL_PROVIDER=console
EMAIL_TIMEOUT_MS=8000
RESEND_API_KEY=<DEFINIR_SE_EMAIL_PROVIDER_FOR_RESEND>
SMTP_HOST=smtp.provedor.com.br
SMTP_PORT=587
SMTP_USER=no-reply@farmaubs.com.br
SMTP_PASS=<DEFINIR_SENHA_SMTP>
SMTP_FROM=no-reply@farmaubs.com.br
SMTP_SECURE=true

# ------------------------------------------------------------
# SEÇÃO 5 — SEGURANÇA DE DADOS (NF010 — LGPD)
# ------------------------------------------------------------

# Chave AES-256 (32 bytes) para criptografia em repouso de CNS/CPF
ENCRYPTION_KEY=<GERAR_CHAVE_32_BYTES>

# ------------------------------------------------------------
# SEÇÃO 6 — ALERTAS E PARÂMETROS OPERACIONAIS (RF022/RF023/RF027)
# ------------------------------------------------------------

ALERT_EXPIRY_DAYS=90            # RF022 — limiar de alerta de vencimento
ALERT_SHORT_VALIDITY_MONTHS=6   # RF024 — validade curta exige confirmação
SAFETY_STOCK_DAYS=30            # RF027 — estoque de segurança (dias)
CAF_LEAD_TIME_DAYS=15           # RF015 — tempo médio de entrega da CAF

# ------------------------------------------------------------
# SEÇÃO 7 — RELATÓRIOS (ADR-009)
# ------------------------------------------------------------

REPORTS_DIR=./storage/reports
REPORTS_RETENTION_HOURS=48      # expurgo de arquivos gerados (RL-03)
MAINTENANCE_JOBS_ENABLED=true   # habilita limpeza periódica de sessões expiradas e relatórios antigos (RL-03)

# ------------------------------------------------------------
# SEÇÃO 8 — OBSERVABILIDADE (ADR-026 / RL-04)
# ------------------------------------------------------------

LOG_LEVEL=info
# Opcional: preencha para ativar captura de erros no Sentry com redação automática de PII
SENTRY_DSN=

# ------------------------------------------------------------
# SEÇÃO 9 — FRONTEND (Vite / React — ADR-011)
# ------------------------------------------------------------

# URL base da API consumida pelo frontend (/api/v1 usa o proxy reverso do Vite evitando CORS)
VITE_API_URL=/api/v1

# Alvo da API backend direcionado pelo proxy reverso do Vite em desenvolvimento
VITE_PROXY_TARGET=http://localhost:3000

# ------------------------------------------------------------
# SEÇÃO 10 — BOOTSTRAP DE PRODUÇÃO E SEED DE QA (RL-02 / ADR-025)
# ------------------------------------------------------------

# Usadas apenas na execução inicial de node dist/database/bootstrap-prod.js em produção
BOOTSTRAP_MUNICIPIO_NOME=Parnaíba
BOOTSTRAP_MUNICIPIO_UF=PI
BOOTSTRAP_MUNICIPIO_IBGE=2207702
BOOTSTRAP_UBS_NOME=UBS Piloto FarmaUBS
BOOTSTRAP_ADMIN_EMAIL=admin@farmaubs.com.br
BOOTSTRAP_ADMIN_PASSWORD=<DEFINIR_SENHA_PROVISORIA_FORTE>

# Usadas exclusivamente em homologação (APP_ENV=hml) por node dist/database/seed-qa.js
ALLOW_QA_SEED=false
QA_SMOKE_EMAIL=qa.smoke@farmaubs.dev
QA_SMOKE_PASSWORD=<DEFINIR_SENHA_CONTA_SMOKE_QA>