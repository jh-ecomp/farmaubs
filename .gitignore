# Dependências (todos os workspaces do monorepo)
node_modules/
**/node_modules/
.pnpm-store/

# Builds (todos os workspaces)
dist/
**/dist/
build/
**/build/
.temp
.tmp

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Variáveis de ambiente (ADR-027) — nunca versionar, exceto o exemplo
.env
.env.*
!.env.example

# Arquivos gerados pelo editor/OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Cobertura de testes (ADR-030 — Jest)
coverage/
**/coverage/

# Estado incremental do TypeScript (recompilação do nest start --watch)
*.tsbuildinfo

# Relatórios gerados em runtime (ADR-009 — REPORTS_DIR=./storage/reports)
storage/reports/

# Cache de build do vite-plugin-pwa (ADR-014 — preventivo)
dev-dist/

# ==========================================
# Ferramentas de IA e Assistentes de Código
# ==========================================

# Claude Code (Anthropic)
.claude/
claude_*.log

# Antigravity (Google / Dev Tools)
.antigravity/
antigravity.config.local.json
antigravity-cache/
.agents/
graphify-out/
scratch/

# GitHub Copilot & VS Code AI extensions
.copilot/
.github/copilot-instructions.md # (Opcional: ignore apenas se forem regras estritamente pessoais)

# Cursor Editor
.cursor/
.cursorrules # (Opcional: remova desta lista se quiser compartilhar regras com o time)

# Continue.dev
.continue/

# Aider (AI pair programmer)
.aider*
!.aider.conf.json # (Opcional: mantenha se quiser compartilhar a configuração base)

# Supermaven
.supermaven/

# Cody (Sourcegraph)
.cody/

# Arquivos genéricos de histórico e logs de LLMs
*.prompt
*.llm.log
